import type { StackProps } from 'aws-cdk-lib';
import { Stack, Stage, Tags } from 'aws-cdk-lib';
import { Secret } from 'aws-cdk-lib/aws-secretsmanager';
import type { Construct } from 'constructs';
import { EXAMPLE_CONFIGURATIONS, getStageConfig } from './config';

export interface SharedInfraProps {
    // Stage config (see ./config)
    exampleBaseUrl: string;
    // Secrets
    secretExample: Secret;
}

export class SharedInfraStack extends Stack {
    readonly exampleBaseUrl: string;
    readonly secretExample: Secret;

    constructor(scope: Construct, id: string, props?: StackProps) {
        super(scope, id, props);

        const stageName = Stage.of(this)?.stageName;
        if (!stageName) {
            throw new Error('This construct must be used within a CDK Stage');
        }

        Tags.of(this).add('SERVICE', id);

        const exampleConfig = getStageConfig(EXAMPLE_CONFIGURATIONS, stageName, 'Example');
        this.exampleBaseUrl = exampleConfig.baseUrl;

        // Secrets
        // CloudFormation generates a random placeholder value for each secret on first deploy
        this.secretExample = new Secret(this, 'SecretExample', {
            description: 'Example secret shared across services',
            generateSecretString: {
                secretStringTemplate: JSON.stringify({
                    username: 'placeholder',
                    password: 'placeholder',
                }),
                generateStringKey: '_generatedKey',
            },
        });
    }

    getProps(): SharedInfraProps {
        return {
            exampleBaseUrl: this.exampleBaseUrl,
            secretExample: this.secretExample,
        };
    }
}
