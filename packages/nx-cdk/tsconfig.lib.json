{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "types": ["node"],
        // This package is built via plain `@nx/js:tsc`, so these must be overridden to
        // emit real CommonJS .js output — matching `"type": "commonjs"` in package.json.
        "emitDeclarationOnly": false,
        "module": "Node16",
        "moduleResolution": "Node16"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["vitest.config.mjs", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
