{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": true,
        // No `baseUrl` — deprecated in TypeScript 6, removed in 7. `paths` are
        // relative to this file, which sits one level below the app root.
        "paths": {
            "@/*": ["../src/*"]
        }
    },
    "include": ["**/*.test.ts", "../global-types"],
    "exclude": []
}
