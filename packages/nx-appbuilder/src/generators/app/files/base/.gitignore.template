# Test coverage
coverage

# Extension actions, app manifest and config schema generated by
# `@adobe/aio-commerce-lib-app` (its pre-app-build hook, or `generate all`).
#
# These are build *inputs* as well as outputs — the configuration extension's
# actions import `#app.commerce.config`, which resolves into the extensibility
# extension's `.generated` — so a missing one fails the build rather than being
# regenerated on demand. Ignoring them makes that unambiguous: anything here is
# disposable, `generate all` rebuilds it.
#
# Globbed rather than listed per extension so a new extension point is covered
# without remembering to add it.
src/*/.generated/

# Action URL registry written by scripts/generate-action-registry.mjs
src/*/web-src/src/action-urls.generated.json
