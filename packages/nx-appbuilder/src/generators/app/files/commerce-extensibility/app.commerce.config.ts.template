import { defineConfig } from '@adobe/aio-commerce-lib-app/config';

export default defineConfig({
    metadata: {
        id: '<%= name %>',
        displayName: '<%= displayName %>',
        description: '<%= description %>',
        version: '0.0.1',
    },
<%_ if (hasAdminUI) { _%>
    // Drives the `commerce/backend-ui/2` extension. The lib regenerates
    // src/commerce-backend-ui-2/ext.config.yaml from this on every pre-app-build,
    // so the extension manifest is never hand-maintained.
    //
    // `menu.id` may only contain letters, digits, `/`, `:` and `_` — hyphens are
    // rejected, hence the underscored slug.
    //
    // Beyond `menu`, this section also accepts `order`, `product` and `customer`
    // keys for grid columns, mass actions and order view buttons. See
    // https://github.com/adobe/aio-commerce-sdk/blob/main/packages/aio-commerce-lib-app/docs/usage.md
    adminUi: {
        menu: {
            id: '<%= appSlug %>',
            label: '<%= displayName %>',
            description: '<%= description %>',
            pageTitle: '<%= displayName %>',
<%_ if (parentMenu !== 'none') { _%>
            parentMenu: '<%= parentMenu %>',
<%_ } else { _%>
            // parentMenu: 'sales', // omit for a top-level item
<%_ } _%>
            // Commerce generates a per-app ACL resource (derived from
            // `metadata.id`) so admins can grant or deny this menu item per
            // role. Drop it to make the page visible to every admin user.
            aclProtected: true,
        },
    },
<%_ } _%>
<%_ if (hasBusinessConfig) { _%>
    businessConfig: {
        // Merchant-facing configuration fields. Each one renders a control in
        // the Commerce admin under Stores → Configuration for this app's
        // section. The lib rejects an empty schema, so a placeholder field is
        // declared here — replace it with the app's real settings.
        schema: [
            {
                type: 'text',
                name: 'sample_setting',
                label: 'Sample Setting',
                description: 'Placeholder field scaffolded by the generator. Replace me.',
            },
            // {
            //     type: 'list',
            //     name: 'environment',
            //     label: 'Environment',
            //     selectionMode: 'single',
            //     options: [
            //         { label: 'Staging', value: 'staging' },
            //         { label: 'Production', value: 'production' },
            //     ],
            //     default: 'staging',
            // },
        ],
    },
<%_ } _%>
<%_ if (hasEvents) { _%>
    eventing: {
        // Commerce events fire from Adobe Commerce instances. Subscribe a
        // runtime action by name; pre-app-build wires it up.
        commerce: [
            {
                provider: {
                    label: '<%= displayName %> Commerce Events',
                    description: 'Events emitted by the connected Commerce instance.',
                },
                events: [
                    {
                        name: 'observer.sales_order_place_after',
                        label: 'Order placed',
                        description: 'Fired after an order is successfully placed.',
                        fields: [
                            { name: 'order.entity_id' },
                            { name: 'order.increment_id' },
                            { name: 'order.customer_email' },
                        ],
                        runtimeActions: ['<%= runtimePackageName %>/handle-sample-event'],
                    },
                ],
            },
        ],
        // External events come from third-party systems (ERP, CRM, etc.).
        // Remove this block if you don't subscribe to any.
        external: [
            {
                provider: {
                    label: '<%= displayName %> External Events',
                    description: 'Events emitted by an external integration.',
                },
                events: [
                    {
                        name: 'be-observer.sample_event',
                        label: 'Sample external event',
                        description: 'Use case description for the event.',
                        runtimeActions: ['<%= runtimePackageName %>/handle-sample-event'],
                    },
                ],
            },
        ],
    },
<%_ } _%>
<%_ if (hasCommerceWebhooks) { _%>
    // Each webhook binds a Commerce extensibility hook to one of your runtime
    // actions (declared in app.config.yaml). At install time the lib provisions
    // the subscription on the Commerce instance. The lib rejects an empty list,
    // so a sample bound to `src/actions/webhook-sample.ts` is declared here —
    // replace it, or send to an external URL instead by dropping
    // `runtimeAction` / `requireAdobeAuth` and adding `url` under `webhook`.
    //
    // Schema reference:
    //   https://developer.adobe.com/commerce/extensibility/app-management/installation/webhooks/
    webhooks: [
        {
            label: 'Sample order placement hook',
            description: 'Placeholder webhook scaffolded by the generator. Replace me.',
            category: 'validation',
            runtimeAction: '<%= runtimePackageName %>/webhook-sample',
            requireAdobeAuth: true,
            webhook: {
                webhook_method: 'observer.sales_order_place_before',
                webhook_type: 'before',
                batch_name: '<%= appSlug %>_sample_batch',
                hook_name: '<%= appSlug %>_sample_hook',
                method: 'POST',
                priority: 100,
                // Not required: a failure here lets the order through rather
                // than taking checkout down with it. Flip to `true` once the
                // action enforces something that must not be bypassed.
                required: false,
                timeout: 5000,
                fallback_error_message: '<%= displayName %> webhook unavailable',
                fields: [{ name: 'grand_total', source: 'data.order.grand_total' }],
                rules: [],
                headers: [],
            },
        },
    ],
<%_ } _%>
<%_ if (hasCustomInstallSteps) { _%>
    installation: {
        messages: {
            // preInstallation: 'Shown to the merchant before installing the app.',
            // postInstallation: 'Shown to the merchant after the app installs successfully.',
        },
        customInstallationSteps: [
            {
                name: 'sample-step',
                description: 'Use case description for the step.',
                // TypeScript is fine here: the extensibility extension's
                // webpack config compiles it into the installation action.
                script: './scripts/install/sample-step.ts',
            },
        ],
    },
<%_ } _%>
});
