import { useEffect, useRef } from 'react';

import {
    useLazyAppBuilderAction,
    type UseLazyAppBuilderActionOptions,
} from '#web/hooks/useLazyAppBuilderAction.ts';

/**
 * React hook that invokes an App Builder action once on mount, with the host's
 * IMS credentials attached.
 *
 * `useIms()` reads the token and org from the context the host provides — the
 * Commerce Admin over the UIX guest connection, or the Experience Cloud shell.
 * Actions annotated `require-adobe-auth: true` reject the call without them, so
 * the invocation is held until they arrive. An explicit `options.ims` still
 * wins, so a caller can override.
 *
 * For manual invocation, use `useLazyAppBuilderAction` directly.
 *
 * @example
 * ```tsx
 * const { response, loading } = useAppBuilderAction<ConfigData>({
 *     name: 'my-package/get-config',
 *     method: 'GET',
 * });
 *
 * if (loading) return <ProgressCircle isIndeterminate />;
 * return <ConfigForm initialValues={response} />;
 * ```
 */
export function useAppBuilderAction<T = unknown>(options: UseLazyAppBuilderActionOptions) {
    const hasInvokedRef = useRef(false);

    // Credentials and readiness both come from the lazy hook, so the two cannot
    // disagree about whether a call is safe to make.
    const {
        response,
        loading: isInvoking,
        error,
        invoke,
        isReady,
    } = useLazyAppBuilderAction<T>(options);

    useEffect(() => {
        if (hasInvokedRef.current || !isReady) {
            return;
        }
        hasInvokedRef.current = true;
        void invoke();
    }, [invoke, isReady]);

    const loading = isInvoking || (!response && !error);

    return { response, loading, error };
}
