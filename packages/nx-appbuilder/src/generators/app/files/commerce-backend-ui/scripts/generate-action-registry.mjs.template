/**
 * Generates the Admin UI action registry consumed by `callAction` and the
 * `useAppBuilderAction` hooks.
 *
 * Why this exists:
 *   `aio app build` writes a `config.json` into each extension's web-src, but it
 *   only contains the action URLs for that *one* extension. Our custom actions
 *   are declared in `app.config.yaml` under the `application` scope (so they all
 *   live in one place), which means they never appear in the backend-ui
 *   extension's `config.json` — and under `commerce/backend-ui/2` that extension
 *   has no web actions of its own at all.
 *
 * Why it computes URLs itself:
 *   `aio app get-url --json` would resolve every scope for us, but it throws for
 *   any app whose backend-ui extension declares no actions (a live bug in
 *   @adobe/aio-cli-plugin-app / aio-lib-runtime) — which is exactly the shape of
 *   a `commerce/backend-ui/2` extension. A web action's URL is fully determined
 *   by the runtime host and namespace plus its package and action name, so this
 *   derives the same map from `app.config.yaml` (following `$include`s, across
 *   the application and every extension) and the selected workspace's `.env`.
 *
 * This keeps action-URL resolution static (no runtime lookups) while letting all
 * custom actions be declared in a single location.
 */
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

import yaml from 'js-yaml';

const appRoot = join(dirname(fileURLToPath(import.meta.url)), '..');
const outFile = join(
    appRoot,
    'src/commerce-backend-ui-2/web-src/src/action-urls.generated.json'
);

// `aio app use` writes the selected workspace's namespace (and, for non-default
// runtimes, the API host) to `.env`. Already exported values (CI, a wrapper
// script) take precedence, so the file is only consulted when the namespace is
// absent.
const envFile = join(appRoot, '.env');
if (!process.env.AIO_runtime_namespace && existsSync(envFile)) {
    process.loadEnvFile(envFile);
}

const namespace = process.env.AIO_runtime_namespace;
if (!namespace) {
    throw new Error(
        'AIO_runtime_namespace is not set — select a workspace first (e.g. `aio app use`).'
    );
}

// Same derivation as aio-lib-runtime: web actions are served from
// `<namespace>.<apihost>`, with the host defaulting to Adobe's public runtime.
const apihost = new URL(process.env.AIO_runtime_apihost ?? 'https://adobeioruntime.net');
const actionBaseUrl = `${apihost.protocol}//${namespace}.${apihost.host}/api/v1/web`;

/** Loads a YAML file, replacing every `{ $include: <path> }` node with its content. */
function loadYamlWithIncludes(file) {
    const resolveIncludes = (node) => {
        if (Array.isArray(node)) return node.map(resolveIncludes);
        if (node === null || typeof node !== 'object') return node;
        if (typeof node.$include === 'string') {
            return loadYamlWithIncludes(resolve(dirname(file), node.$include));
        }
        return Object.fromEntries(
            Object.entries(node).map(([key, value]) => [key, resolveIncludes(value)])
        );
    };
    return resolveIncludes(yaml.load(readFileSync(file, 'utf-8')));
}

const appConfig = loadYamlWithIncludes(join(appRoot, 'app.config.yaml'));

// Every scope that can declare actions: the standalone application plus each
// extension point. Package names are unique per namespace, so merging them into
// one map is what `aio app get-url` would have produced.
const scopes = [appConfig?.application, ...Object.values(appConfig?.extensions ?? {})];
const packages = Object.assign(
    {},
    ...scopes.map((scope) => scope?.runtimeManifest?.packages ?? {})
);

// Only web-exported actions are reachable from the browser. `web` is a string
// in the manifest (`'yes'`, `'raw'`, `'no'`), but YAML also accepts a bare
// boolean, so both forms are accepted here.
const isWebAction = (action) =>
    ['yes', 'true', 'raw'].includes(String(action?.web ?? 'no').toLowerCase());

const registry = {};
for (const [packageName, pkg] of Object.entries(packages)) {
    for (const [actionName, action] of Object.entries(pkg?.actions ?? {})) {
        if (!isWebAction(action)) continue;
        registry[`${packageName}/${actionName}`] = `${actionBaseUrl}/${packageName}/${actionName}`;
    }
}

// Fail loudly rather than writing an empty registry the UI can't use.
const keys = Object.keys(registry);
if (keys.length === 0) {
    throw new Error(
        'No web actions found in app.config.yaml (application or extension ' +
            "runtimeManifests, including $include'd files). Declare the actions the " +
            "Admin UI calls with `web: 'yes'`."
    );
}

// Sort keys so regeneration produces stable, review-friendly diffs.
const sorted = Object.fromEntries(keys.sort().map((key) => [key, registry[key]]));

writeFileSync(outFile, `${JSON.stringify(sorted, null, 4)}\n`, 'utf-8');
console.log(`Wrote ${keys.length} action URL(s) to ${outFile}`);