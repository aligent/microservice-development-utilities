#!/usr/bin/env bash

echo -e "\n⏩ Generating action registry before build... 🔍\n"

if npm run generate:action-registry; then
  echo -e "\n⏩ Action registry generated successfully! ✅\n"
  # Exiting with 0 allows the build to continue
  exit 0
else
  echo -e "\n⏩ Action registry generation failed: ❌\n"
  # Exiting with non-zero will cause the build to be skipped/failed
  exit 1
fi
