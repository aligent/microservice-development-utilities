{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "types": ["node"],
        // This package is rollup-bundled as tsconfigs-extend assumes. `target`
        // is pinned deliberately to ES2022 guarantee compatibility for Node 18
        // consumers. It also keeps class emission as real `class` syntax
        // (not ES5 IIFEs), which bundlers can't tree-shake as cleanly.
        "target": "ES2022",
        "checkJs": false
    },
    "include": ["src/**/*.ts"],
    "exclude": ["vitest.config.mjs", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
