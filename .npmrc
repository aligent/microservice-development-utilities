# This workspace uses Yarn Berry (see .yarnrc.yml), but `nx release publish`/`version`
# still shell out to the real `npm` CLI under the hood and resolve the registry via
# `npm config get registry`, which reads this file. Also toggled by nx.json's
# start-local-registry / stop-local-registry targets for local verdaccio testing.
# Keep this file even though the value below is npm's own default.
registry=https://registry.npmjs.org/
